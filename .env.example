# Crea un proyecto en https://supabase.com y copia estas variables a `.env.local`.
# Sin estas variables la app corre en MODO LOCAL (seed data en memoria).

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side (no exponer al cliente). Usar desde una función edge / backend.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
META_GRAPH_API_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
TIKTOK_ADS_TOKEN=
