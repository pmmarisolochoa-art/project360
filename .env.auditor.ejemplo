# Copia este archivo a .env.auditor y rellena lo que quieras usar.
# El que no configures simplemente no se usa: el informe siempre queda en el repo.

# Correo (usa el mismo Resend de las invitaciones)
RESEND_API_KEY=
INFORME_EMAIL_TO=
INFORME_EMAIL_FROM=

# Telegram (el token lo da @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
